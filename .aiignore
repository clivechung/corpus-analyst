# ==============================================================================
# .aiignore - AI Context Ingestion Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Keys, Secrets, and Credentials (CRITICAL)
# ------------------------------------------------------------------------------
# Environment variables & configuration secrets
.env
.env.*
!.env.example
!.env.template
*.env
.envrc

# API keys, tokens & credentials files
*secret*
*credential*
*password*
*.token
*.key
*.pem
*.pub
*.pfx
*.p12
*.pkcs12
*.crt
*.cer
*.der
*.jks
*.keystore
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*

# Cloud & Service credentials
credentials.json
client_secret*.json
service-account*.json
service_account*.json
firebase-adminsdk*.json
*token*.json
auth.json
.vault-token
kubeconfig
*.kcfg

# Tool configuration with credentials
.aws/
.azure/
.gcp/
.netrc
.pypirc
.npmrc
.dockercfg
.docker/config.json
.streamlit/secrets.toml

# ------------------------------------------------------------------------------
# 2. Python (Environments, Caches, & Build Artifacts)
# ------------------------------------------------------------------------------
# Bytecode and runtime caches
__pycache__/
*.py[codz]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.pixi/
__pypackages__/
.pdm-python
.pdm-build/

# Packaging and distributions
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec

# Testing, linting, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.hypothesis/
.pyre/
.pytype/
.dmypy.json
dmypy.json
.cache/

# Jupyter & Notebook caches
.ipynb_checkpoints
profile_default/
ipython_config.py

# ------------------------------------------------------------------------------
# 3. Docker & Docker Compose (Data Volumes, Runtime State & Logs)
# ------------------------------------------------------------------------------
# Docker volumes & persistent state
volumes/
docker-data/
postgres-data/
mysql-data/
mongo-data/
redis-data/
rabbitmq-data/
activemq-data/
mnesia/
*.rdb
*.aof
*.pid

# Local docker compose overrides containing local sensitive config
docker-compose.override.yml

# Logs & temporary runtime files
*.log
logs/
*.sock

# ------------------------------------------------------------------------------
# 4. Large Data, Database Dumps & Binaries
# ------------------------------------------------------------------------------
*.sqlite3
*.sqlite3-journal
*.db
*.dump
*.parquet
*.h5
*.hdf5
*.pkl
*.pickle
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.gz

# ------------------------------------------------------------------------------
# 5. VCS & OS Metadata
# ------------------------------------------------------------------------------
.git/
.DS_Store
Thumbs.db
