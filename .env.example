# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Domain & Paths
DEFAULT_DOMAIN=finance
CONFIG_PATH=config/config.yaml
MODELS_CONFIG_PATH=config/models.json
DATA_LAKE_PATH=/data/lake
DATA_INCOMING_PATH=/data/incoming
DATA_PROCESSED_PATH=/data/processed
DATA_FAILED_PATH=/data/failed

# Embedding Configuration
EMBEDDING_PROFILE=finance
MODEL_CACHE_DIR=/root/.cache/huggingface

# Storage & Azure Edge Blob (Azurite)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://edgeblob:10000/devstoreaccount1;
AZURE_CONTAINER_NAME=sec-filings-lake
AZURE_CONTAINER_NAME=corpus-lake
AZURITE_EMULATOR_ENABLED=true
# Storage Configuration (LocalFS Default, Pluggable for Cloud Azure Blob)
STORAGE_PROVIDER=localfs
STORAGE_LOCAL_PATH=/data/lake
# Optional Cloud Azure Blob Storage (Future Extension)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# AZURE_CONTAINER_NAME=corpus-lake

# Query Engine Service
QUERY_ENGINE_HOST=0.0.0.0
QUERY_ENGINE_PORT=8000
DUCKDB_PATH=:memory:
DEFAULT_TOP_K=5
SIMILARITY_THRESHOLD=0.0

# LLM Providers
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# SEC Edgar Ingestion Defaults
SEC_USER_AGENT="CorpusAnalystAdmin admin@corpus-analyst.local"

